{
  "name": "@beacon/executors",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./simulated": {
      "types": "./dist/simulated.d.ts",
      "default": "./dist/simulated.js"
    },
    "./faults": {
      "types": "./dist/faults.d.ts",
      "default": "./dist/faults.js"
    },
    "./sandbox": {
      "types": "./dist/sandbox.d.ts",
      "default": "./dist/sandbox.js"
    },
    "./sandbox-config": {
      "types": "./dist/sandbox-config.d.ts",
      "default": "./dist/sandbox-config.js"
    },
    "./command": {
      "types": "./dist/command.d.ts",
      "default": "./dist/command.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "contract:sandbox": "node dist/contract/cli.js"
  },
  "dependencies": {
    "@beacon/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
