{
  "name": "@beacon/mcp-ops",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "start:http": "node --env-file-if-exists=../../.env dist/http-server.js",
    "spike": "pnpm run build && node --env-file-if-exists=../../.env dist/spike/spike-client.js"
  },
  "dependencies": {
    "@beacon/core": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "exports": {
    "./tools/registry": {
      "types": "./dist/tools/registry.d.ts",
      "default": "./dist/tools/registry.js"
    }
  }
}
