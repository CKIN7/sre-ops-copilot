{
  "name": "@beacon/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "start": "pnpm run build && node --env-file-if-exists=../../.env dist/main.js",
    "cli": "pnpm run build && node --env-file-if-exists=../../.env dist/cli.js"
  },
  "dependencies": {
    "@beacon/core": "workspace:*",
    "@beacon/gateway": "workspace:*",
    "@beacon/orchestrator": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}