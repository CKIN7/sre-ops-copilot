# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# mcp-ops por HTTP (Streamable HTTP stateless, ADR-002)
MCP_HOST=127.0.0.1
MCP_PORT=4000
# Token de servicio que presenta el gateway; 32+ caracteres. Generar con
# `openssl rand -hex 32`. Vacio: el transporte HTTP no arranca.
MCP_AUTH_TOKEN=
# Endpoint que consume el gateway de la API.
MCP_URL=http://127.0.0.1:4000/mcp

# API (apps/api)
# JSON: token de operador -> tenant/user/agent. La clave es el token (32+ chars).
# Ejemplo (sin valor real):
# AUTH_TOKENS_JSON='{"<token>":{"tenant":"shop","user":"oncall@shop.test","agent":"incident-copilot"}}'
AUTH_TOKENS_JSON=

# CLI
BEACON_API_URL=http://127.0.0.1:3000
BEACON_TOKEN=

# Base de datos
# Postgres local en infra/compose/docker-compose.yml. Si el 5432 esta ocupado,
# cambiar POSTGRES_PORT y el puerto de DATABASE_URL a la vez.
POSTGRES_USER=beacon
POSTGRES_PASSWORD=beacon
POSTGRES_DB=beacon
POSTGRES_PORT=5432
DATABASE_URL=postgres://beacon:beacon@localhost:5432/beacon

# Seed determinista
# 1 = un punto por minuto y metrica (3.110.400 puntos).
# 0.5 = cada 2 min; 0.1 = cada 10 min (311.040 puntos); 0.02 = cada 50 min.
# Valores > 1 se recortan a 1. El dataset es reproducible byte a byte cuando
# SEED_ANCHOR_ISO fija el fin de la ventana; vacio = ahora (redondeado al minuto).
SEED_SCALE=1
SEED_ANCHOR_ISO=

# Modelo
MODEL_PROVIDER=
MODEL_ID=
MODEL_API_KEY=
# live | mock (mock usa respuestas guionizadas, sin clave ni coste)
MODEL_MODE=mock

# Ejecución de acciones
# simulated | sandbox
EXECUTOR=simulated
# Presupuesto (docs/plan.md §4.5): tokens y reloj por run; agregado del tenant.
# El coste por run sale de agents.budget_cents (el seed pone 10 centimos).
BUDGET_RUN_TOKENS_IN=200000
BUDGET_RUN_TOKENS_OUT=50000
BUDGET_RUN_WALL_MS=90000
BUDGET_TENANT_COST_CENTS=10000
BUDGET_TENANT_TOKENS_IN=5000000
BUDGET_TENANT_TOKENS_OUT=1000000
BUDGET_TENANT_WALL_MS=3600000
BUDGET_RESERVATION_TTL_MS=300000
# kind | compose (compose aun no tiene adaptador real: falla cerrado)
SANDBOX_TARGET=kind
SANDBOX_NAMESPACE=beacon-sandbox
# Opcionales: contexto y kubeconfig. Nunca se commitea un kubeconfig.
SANDBOX_CONTEXT=
SANDBOX_KUBECONFIG=
SANDBOX_POLL_INTERVAL=2s
SANDBOX_COMMAND_TIMEOUT=60s
# Fallos inyectados: 409, timeout, partial, rate_limited, readiness
FAULTS=
READINESS_TIMEOUT=30s

# Demo publica (se enforza en el gateway, nunca en la UI)
DEMO_MODE=0
REPLAY_ONLY=0
DEMO_SESSION_BUDGET_CENTS=5
DEMO_SESSION_MAX_STEPS=6
DEMO_SESSION_TTL_MS=3600000
DEMO_DAILY_SESSIONS=200
DEMO_FAILURE_THRESHOLD=5
DEMO_RATE_LIMIT_IP=30
DEMO_RATE_LIMIT_SESSION=6
DEMO_RATE_LIMIT_WINDOW_MS=3600000
# Archivo o directorio de fixtures para el fallback a replay (obligatorio si
# DEMO_MODE=1): la demo grabada no llama a mcp-ops.
DEMO_REPLAY_FIXTURES=packages/evals/fixtures/golden

# Observabilidad
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=beacon
